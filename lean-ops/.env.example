# ============================================================
# LeanOps 环境配置
# 复制此文件为 .env 并修改
# ============================================================

# 应用
APP_NAME=LeanOps
APP_VERSION=1.0.0
APP_ENV=development           # development / production / testing
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key

# 服务器
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 数据库 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/leanops.db

# 数据库 (PostgreSQL) — 可选
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/leanops

# JWT
JWT_SECRET_KEY=change-me-to-another-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# 文件上传
UPLOAD_DIR=./app/static/uploads
MAX_UPLOAD_SIZE=10485760      # 10MB

# 日志
LOG_LEVEL=INFO
